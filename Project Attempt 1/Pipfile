[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
numpy = ">=2.0.0"
pandas = ">=2.2.0"
scipy = ">=1.13.0"
statsmodels = ">=0.14.0"
scikit-learn = ">=1.5.0"
xgboost = ">=2.1.0"
yfinance = ">=0.2.50"
pandas-datareader = ">=0.10.0"
requests = ">=2.31.0"
ta = ">=0.11.0"
pyarrow = ">=16.0.0"
matplotlib = ">=3.9.0"
seaborn = ">=0.13.0"
jupyterlab = ">=4.2.0"
ipykernel = ">=6.29.0"

[requires]
python_version = "3.12"

[scripts]
pipeline_download = "python run_pipeline.py --mode download"
pipeline_local = "python run_pipeline.py --mode local"
pipeline_incremental = "python run_pipeline.py --mode download --incremental"

